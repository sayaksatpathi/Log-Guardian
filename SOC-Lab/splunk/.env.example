# Copy this file to .env and replace the password with a unique strong value.
# Never commit .env or share this password.
SPLUNK_PASSWORD=ReplaceThisWithALongUniquePassword123!
# Use Splunk Free by default: standalone, 500 MB/day; scheduled alerting is unavailable.
SPLUNK_LICENSE_URI=Free

# Splunk 10.x requires explicit acceptance of its license and General Terms.
# Read the current terms before enabling either setting. Uncomment only if you,
# the operator, accept them:
# SPLUNK_START_ARGS=--accept-license
# SPLUNK_GENERAL_TERMS=--accept-sgt-current-at-splunk-com
